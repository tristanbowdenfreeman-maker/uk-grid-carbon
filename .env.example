# Azure SQL Database (infra/deploy.sh prints these once it has created the server)
MSSQL_HOST=your-server.database.windows.net
MSSQL_PORT=1433
MSSQL_USER=gridadmin
MSSQL_PASSWORD=
MSSQL_DATABASE=GridCarbon

# Azure Blob Storage container the site reads its JSON from. Leave blank to only write site/data/.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=data
